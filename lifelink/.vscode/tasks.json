{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run backend (Spring Boot)",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run backend tests",
      "type": "shell",
      "command": "mvn test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Run everything",
      "dependsOn": ["Run backend (Spring Boot)", "Run frontend (Vite)"],
      "problemMatcher": []
    }
  ]
}
